<?xml version="1.0" encoding="utf-8"?>
<!--
    Inter (OFL, licence in assets/licenses/OFL-Inter.txt), bundled rather than pulled from
    downloadable fonts so the app works offline.

    One variable file serving both weights via fontVariationSettings — shipping Regular and
    Medium as separate static faces would cost more than the whole variable font does.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/inter_variable"
        android:fontStyle="normal"
        android:fontWeight="400"
        android:fontVariationSettings="'wght' 400" />
    <font
        android:font="@font/inter_variable"
        android:fontStyle="normal"
        android:fontWeight="500"
        android:fontVariationSettings="'wght' 500" />
    <font
        android:font="@font/inter_variable"
        android:fontStyle="normal"
        android:fontWeight="600"
        android:fontVariationSettings="'wght' 600" />
</font-family>
