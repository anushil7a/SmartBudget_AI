<?xml version="1.0" encoding="utf-8"?>
<!--
    Space Grotesk (OFL, licence in assets/licenses/OFL-SpaceGrotesk.txt).

    Used only for display numerals. Its figures are the reason it is here: paired with
    fontFeatureSettings="tnum" the digits are the same width, so an animating amount does not
    jitter as the value changes.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/space_grotesk_variable"
        android:fontStyle="normal"
        android:fontWeight="500"
        android:fontVariationSettings="'wght' 500" />
    <font
        android:font="@font/space_grotesk_variable"
        android:fontStyle="normal"
        android:fontWeight="700"
        android:fontVariationSettings="'wght' 700" />
</font-family>
