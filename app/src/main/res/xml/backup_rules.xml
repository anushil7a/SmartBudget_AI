<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules for API 30 (see data_extraction_rules.xml for API 31+).

    Photographed receipts are excluded. They are pictures of the user's shopping, often
    showing a card's last four digits and a store's location, and there is no reason for them
    to leave the device. The expense database itself still backs up, so a restore keeps the
    user's history and the classifier's learned counts — it just re-shows the receipt
    thumbnails as missing.
-->
<full-backup-content>
    <exclude domain="file" path="receipts" />
</full-backup-content>
